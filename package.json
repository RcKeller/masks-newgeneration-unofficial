{
  "name": "masks-newgeneration-unofficial",
  "version": "2.1.2",
  "description": "Core System for Masks: A New Generation",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.js",
    "check-types": "tsc --noEmit",
    "ci": "vite build && node scripts/inject-id.cjs",
    "update-readme": "node scripts/update-readme.js",
    "link:dev": "node scripts/link-dev.js",
    "dev": "npm run link:dist && vite build --watch",
    "watch": "npm run link:dist && vite build --watch",
    "link:dist": "node scripts/link-dist.js",
    "build": "npm run link:dist && vite build && node scripts/inject-id.cjs",
    "build:rc": "npm run check-types && vite build && node scripts/inject-id.cjs",
    "postbuild:rc": "dotenv -e .env -- sh -c 'rsync -avz --delete dist/ \"$DEPLOY_HOST_ALIAS:$DEPLOY_PATH\"'",
    "test": "jest",
    "coverageTest": "jest --collect-coverage --collect-coverage-from='./src/**/*.ts'",
    "releaseLocal": "npm run build && node scripts/releaseLocal.cjs",
    "uuid": "node ./tools/generate-uuids.mjs",
    "generate:villains": "node ./tools/generate-villains.mjs --indir './resources/villains'",
    "packs:to-json": "fvtt-packs to-json",
    "packs:to-ldb": "fvtt-packs to-ldb",
    "clean": "rm -rf dist"
  },
  "author": "Andrew Keller Barrows",
  "license": "MIT",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@rckeller/foundryvtt-devtools": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@types/jquery": "^3.5.33",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fs-extra": "^11.3.2",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#v13.345.1",
    "jest": "^30.2.0",
    "lodash": "^4.17.21",
    "pdf-parse": "^2.4.5",
    "postcss": "^8.5.6",
    "sass": "^1.96.0",
    "tailwindcss": "^4.1.14",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-static-copy": "^3.1.4"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "symlink-dir": "^6.0.5"
  }
}
