{{!-- Info Tab: Biography, Look, Abilities, Questions, Influences --}}
<div class="tab info active" data-group="primary" data-tab="info">
	<section class="sheet-tab">
		{{!-- Biography --}}
		<div class="cell cell--bio">
			<h2 class="cell__title">{{system.details.biography.label}}</h2>
			{{editor system.details.biography.value target="system.details.biography.value" button=true owner=owner editable=editable}}
		</div>

		{{!-- Look --}}
		<div class="cell cell--bio">
			<h2 class="cell__title">{{system.details.look.label}}</h2>
			{{editor system.details.look.value target="system.details.look.value" button=true owner=owner editable=editable}}
		</div>

		{{!-- Abilities --}}
		<div class="cell cell--bio">
			<h2 class="cell__title">{{system.details.abilities.label}}</h2>
			{{editor system.details.abilities.value target="system.details.abilities.value" button=true owner=owner editable=editable}}
		</div>

		{{!-- Backstory --}}
		<div class="cell cell--bio">
			<h2 class="cell__title">{{system.details.backstory.label}}</h2>
			{{editor system.details.backstory.value target="system.details.backstory.value" button=true owner=owner editable=editable}}
		</div>

		{{!-- Team Question --}}
		<div class="cell cell--teamQuestion">
			<h2 class="cell__title">{{system.attributes.teamQuestion.label}}</h2>
			{{#if system.attributes.teamQuestion.description}}
			<p class="cell__description">{{system.attributes.teamQuestion.description}}</p>
			{{/if}}
			{{editor system.attributes.teamQuestion.value target="system.attributes.teamQuestion.value" button=true owner=owner editable=editable}}
		</div>

		{{!-- Relationship Questions --}}
		<div class="cell cell--relationshipQuestions">
			<h2 class="cell__title">{{system.attributes.relationshipQuestions.label}}</h2>
			{{#if system.attributes.relationshipQuestions.description}}
			<p class="cell__description">{{system.attributes.relationshipQuestions.description}}</p>
			{{/if}}
			{{editor system.attributes.relationshipQuestions.value target="system.attributes.relationshipQuestions.value" button=true owner=owner editable=editable}}
		</div>

		</section>
</div>
