{{!-- Influence Tab: Track who has influence over whom --}}
<div class="tab influence" data-group="primary" data-tab="influence">
	<div class="cell cell--influences">
		<h2 class="cell__title">
			<label class="item-group-label">{{localize "DISPATCH.Influences"}}</label>
			<div>
				<button type="button" class="item-control item-create" data-action="create-influence">
					<i class="fas fa-plus"></i>
				</button>
			</div>
		</h2>
		<ol class="items-list influences-list">
			{{#each flags.masks-newgeneration-unofficial.influences}}
			<li class="item flexrow {{#if locked}}locked{{/if}}" data-influence-id="{{id}}">
				<div class="influence-name">
					<input type="text" class="influence--name" value="{{name}}" placeholder="{{localize 'DISPATCH.Person-Name'}}" {{#if locked}}readonly{{/if}} />
				</div>
				<div class="influence-management flexrow">
					<img class="influence-icon {{#unless hasInfluenceOver}}influence-disabled{{/unless}}"
						src="modules/masks-newgeneration-unofficial/images/team-downgrade.svg"
						data-action="toggle-influence" data-direction="hasInfluenceOver"
						data-tooltip="{{localize 'DISPATCH.HasInfluence'}}" />
					<img class="influence-icon {{#unless haveInfluenceOver}}influence-disabled{{/unless}}"
						src="modules/masks-newgeneration-unofficial/images/team-upgrade.svg"
						data-action="toggle-influence" data-direction="haveInfluenceOver"
						data-tooltip="{{localize 'DISPATCH.HaveInfluence'}}" />
					<a class="influence-control influence-lock" data-action="toggle-influence-lock">
						<i class="fas {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i>
					</a>
					<a class="influence-control influence-delete" data-action="delete-influence">
						<i class="fas fa-trash"></i>
					</a>
				</div>
			</li>
			{{/each}}
		</ol>
		{{#unless flags.masks-newgeneration-unofficial.influences}}
		<p class="no-influences">{{localize "DISPATCH.NoInfluences"}}</p>
		{{/unless}}
	</div>
</div>
